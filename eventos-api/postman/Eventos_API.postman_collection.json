    {
      "name": "01 - Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"ejecucion\", Date.now().toString() + \"-\" + Math.random().toString(36).slice(2, 8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Comprobar status\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
            ]
          }
        }
      ]
    },
